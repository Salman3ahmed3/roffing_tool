---
import { SITE } from '../config/site';
---

<a class="badge" href="/methodology/">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1f4bc0" stroke-width="2" aria-hidden="true">
    <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path><path d="M8.5 12l2.5 2.5 4.5-5"></path>
  </svg>
  <b>Formula verified</b><span class="muted">· Last reviewed {SITE.lastReviewed}</span>
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    padding: 8px 12px;
    min-height: 36px;
    border: var(--line);
    background: var(--color-surface);
    font-size: 13px;
    color: var(--color-text);
    text-decoration: none;
    flex: none;
  }
  .badge:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  @media print {
    .badge {
      border: 0;
      padding: 0;
    }
  }
</style>
