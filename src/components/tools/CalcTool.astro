---
/**
 * Shell for the materials-style calculators. The default slot takes <ToolStep> groups of fields
 * (Step 1 carries the Units toggle).
 * Server-renders the default result so numbers are visible before JS runs;
 * /src/scripts/calc-tool.ts restores state from the URL and keeps everything live.
 */
import ToolActions from './ToolActions.astro';
import MaterialsList from './MaterialsList.astro';
import { SPECS, type SpecId } from '../../lib/tools/registry';

interface Props {
  spec: SpecId;
  label: string;
  results: { key: string; label: string }[];
  listNote?: string;
}
const { spec, label, results, listNote } = Astro.props;
const s = SPECS[spec];
const view = s.evaluate(s.defaults);
---

<div class="calc" data-calc={spec} data-unit={s.defaults.u}>
  <section class="tool calc-tool" aria-label={label}>
    <div class="calc-fields">
      <slot />
    </div>
    <div class="note calc-status" data-status-box data-tone={view.status.tone}>
      <svg class="note-ico ico-info" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.5" stroke-linecap="square"></path>
      </svg>
      <svg class="note-ico ico-warn" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 3 2 21h20z M12 10v5 M12 17.5v.5" stroke-linecap="square"></path>
      </svg>
      <p data-status>{view.status.text}</p>
    </div>

    <dl class="results four" data-results>
      {
        results.map((r, i) => (
          <div class:list={['result', { primary: i === 0 }]}>
            <dt>{r.label}</dt>
            <dd data-out={r.key}>{view.results?.[r.key]?.value ?? '—'}</dd>
            <dd class="sub" data-sub={r.key}>{view.results?.[r.key]?.sub ?? ''}</dd>
          </div>
        ))
      }
    </dl>
    <p class="calc-summary tnum" data-summary>{view.summary}</p>
    <ToolActions id={`${spec}-tool`} />
    <p class="print-only print-url">Results link: <span data-print-url></span></p>
    <div class="sr-only" aria-live="polite" aria-atomic="true" data-live></div>
  </section>
  <slot name="help" />

  <MaterialsList items={view.list} meta={view.listMeta} note={listNote} />
</div>

<script>
  import { initCalcTool } from '../../scripts/calc-tool';
  import { SPECS, type SpecId } from '../../lib/tools/registry';
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((el) => {
    const spec = SPECS[el.dataset.calc as SpecId];
    if (spec) initCalcTool(el, spec);
  });
</script>

<style is:global>
  /* ── Steps ──────────────────────────────────────────── */
  .calc-fields {
    padding: 0 var(--space-4);
  }
  .calc-step {
    padding: var(--space-6) 0;
  }
  .calc-step + .calc-step {
    border-top: var(--line);
  }
  .step-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .step-intro {
    min-width: 0;
  }
  .step-label {
    margin: 0;
    font-size: 12px;
    font-weight: var(--fw-heavy);
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .step-hint {
    margin: var(--space-1) 0 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-neutral-700);
  }
  .calc .units-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .segr.units {
    width: 200px;
  }
  /* Equal columns: every control lines up on both edges. One column on phones. */
  .step-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .step-grid > .wide {
    grid-column: 1 / -1;
  }
  .calc-fields [hidden] {
    display: none !important;
  }
  /* Bold label + muted helper on one line, same height everywhere so controls align. */
  .calc .field-label {
    min-height: 20px;
    line-height: 20px;
  }
  /* A <legend> sits outside the fieldset's flex flow, so give it the same 6px gap as a <label>. */
  .calc fieldset.field > legend.field-label {
    margin-bottom: 6px;
  }
  .calc .field-label.row {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    align-items: center;
  }
  .step-note {
    margin: calc(var(--space-2) * -1) 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-neutral-700);
  }
  .field-link {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-accent);
    text-underline-offset: 3px;
  }
  .field-link:hover {
    color: var(--color-accent-700);
  }
  .from-tag {
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    background: var(--color-accent-100);
    color: var(--color-accent-800);
    padding: 0 6px;
    white-space: nowrap;
  }
  .from-tag[hidden] {
    display: none;
  }
  .calc[data-unit='imp'] .u-met,
  .calc[data-unit='met'] .u-imp {
    display: none;
  }
  @media (max-width: 639px) {
    .step-head {
      flex-direction: column;
      align-items: stretch;
    }
    .calc .units-row {
      justify-content: space-between;
    }
    .segr.units {
      width: auto;
      flex: 1;
      max-width: 240px;
    }
  }
  @media (min-width: 640px) {
    .step-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-6);
    }
  }

  /* ── Status note (directly above the results) ───────── */
  .calc-status {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    margin: 0 var(--space-4) var(--space-4);
    padding: 10px var(--space-3);
    background: var(--color-accent-100);
    color: var(--color-neutral-800);
  }
  .calc-status p {
    margin: 0;
  }
  .note-ico {
    flex: none;
    margin-top: 2px;
    color: var(--color-accent);
  }
  .calc-status .ico-warn,
  .calc-status[data-tone='warn'] .ico-info {
    display: none;
  }
  .calc-status[data-tone='warn'] .ico-warn {
    display: block;
    color: currentColor;
  }
  .calc-status[data-tone='warn'] {
    background: #fdf3e1;
    color: #5c3d00;
    border-left: 3px solid #8f5f06;
  }

  /* ── Results ────────────────────────────────────────── */
  .calc .results .result dd.sub {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-neutral-700);
    white-space: normal;
  }
  .calc-summary {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-top: var(--line);
    font-size: 13px;
    color: var(--color-neutral-700);
  }

  /* ── Segmented control (radios) — same look as the roof pitch mode switch ── */
  .segr {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    border: 1px solid var(--color-neutral-500);
    background: var(--color-surface);
  }
  .segr-opt {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 var(--space-2);
    font-size: 14px;
    text-align: center;
    color: var(--color-text);
    cursor: pointer;
    white-space: nowrap;
  }
  .segr-opt + .segr-opt {
    border-left: 1px solid var(--color-neutral-500);
  }
  .segr-opt input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .segr-opt:has(input:checked) {
    background: var(--color-accent);
    color: var(--color-surface);
    font-weight: var(--fw-heavy);
  }
  .segr-opt:not(:has(input:checked)):hover {
    background: var(--color-accent-100);
    color: var(--color-accent-700);
  }
  .segr-opt:has(input:focus-visible) {
    z-index: 1;
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }
  /* "Recommended" tag sits under its chip; the space is reserved so nothing shifts. */
  .segr.has-rec {
    margin-bottom: 22px;
  }
  .seg-rec {
    position: absolute;
    top: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0 6px;
    background: var(--color-accent-100);
    color: var(--color-accent-700);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    line-height: 16px;
    white-space: nowrap;
  }
  .seg-rec[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .segr-opt {
      transition: background-color 150ms ease, color 150ms ease;
    }
  }
  .input-group.select select {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 var(--space-3);
    font-size: 15px;
    color: var(--color-text);
  }

  /* Materials list */
  .mlist {
    margin-top: var(--space-6);
    background: var(--color-surface);
    border: var(--line);
  }
  .mlist-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: var(--rule);
  }
  .mlist-title {
    display: flex;
    flex-direction: column;
  }
  .mlist-title h2 {
    font-size: 18px;
    letter-spacing: 0;
  }
  .mlist-title .muted {
    font-size: 12px;
  }
  .mlist-btns {
    display: flex;
    gap: var(--space-2);
  }
  .mlist-items {
    list-style: none;
    margin: 0;
    padding: 0;
    font-variant-numeric: tabular-nums;
  }
  .mlist-items li {
    border-bottom: 1px dashed var(--color-neutral-400);
  }
  .mlist-items label {
    display: grid;
    grid-template-columns: 22px 1fr auto 56px;
    gap: 12px;
    align-items: center;
    min-height: 52px;
    padding: 4px var(--space-4);
    font-size: 15px;
    cursor: pointer;
  }
  .mlist-items input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--color-accent);
  }
  .mlist-items .qty {
    font-size: 18px;
    text-align: right;
  }
  .mlist-items .unit {
    font-size: 13px;
    color: var(--color-neutral-700);
  }
  .mlist-items li:has(input:checked) .name {
    text-decoration: line-through;
    color: var(--color-neutral-700);
  }
  .mlist-items:empty::before {
    content: 'Enter valid measurements to build the list.';
    display: block;
    padding: var(--space-4);
    color: var(--color-neutral-700);
    font-size: 14px;
  }
  .mlist-note {
    margin: 0;
    padding: 14px var(--space-4);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-neutral-700);
  }

  @media (min-width: 900px) {
    .calc-fields {
      padding: 0 var(--space-6);
    }
    .calc-status {
      margin: 0 var(--space-6) var(--space-6);
    }
    .calc-summary {
      padding: var(--space-3) var(--space-6);
    }
    .mlist-head {
      padding: var(--space-4) 20px;
    }
    .mlist-items label {
      padding: 0 20px;
    }
  }

  @media print {
    .calc-fields,
    .calc .tool-actions,
    .mlist-btns,
    .calc-status[data-tone='info'] {
      display: none !important;
    }
    .calc .print-only {
      display: block;
      padding: 8px 16px;
      font-size: 12px;
    }
    .calc .results {
      grid-template-columns: repeat(4, 1fr);
    }
    .calc .result {
      border-bottom: 0;
      border-right: 1px solid #000;
    }
    .calc .result:last-child {
      border-right: 0;
    }
    .calc .result dd {
      font-size: 26px;
      color: #000 !important;
    }
    .mlist {
      border: 1px solid #000;
      break-inside: avoid;
    }
    .mlist-head {
      border-bottom: 2px solid #000;
    }
    .mlist-items li {
      border-bottom: 1px dashed #000;
    }
    .mlist-items input {
      appearance: none;
      -webkit-appearance: none;
      border: 1.5px solid #000;
      width: 16px;
      height: 16px;
    }
    .mlist-items li:has(input:checked) .name {
      text-decoration: none;
      color: #000;
    }
  }
</style>
