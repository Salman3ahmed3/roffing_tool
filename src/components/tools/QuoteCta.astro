---
/**
 * "Get 3 quotes" call to action. Not rendered while FLAGS.showQuotesCta is false
 * (no lead partner yet). When switched on it renders a disabled button until `href` is supplied.
 * Keep ads out of this card.
 */
import { FLAGS } from '../../config/site';
interface Props {
  label?: string;
  href?: string;
}
const { label = 'Get 3 free roofing quotes', href } = Astro.props;
---

{
  FLAGS.showQuotesCta && (
    <div class="quote-cta">
      {href ? (
        <a class="btn btn-primary" href={href}>{label} <span aria-hidden="true">→</span></a>
      ) : (
        <button class="btn btn-primary" type="button" disabled>{label} <span aria-hidden="true">→</span></button>
      )}
    </div>
  )
}

<style>
  .quote-cta {
    margin-top: var(--space-6);
  }
  .quote-cta .btn {
    width: 100%;
    justify-content: space-between;
    min-height: 48px;
  }
</style>
