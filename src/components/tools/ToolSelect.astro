---
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
  value: string;
  wide?: boolean;
  showWhen?: string;
}
const { name, label, options, value, wide = false, showWhen } = Astro.props;
const id = `f-${name}`;
---

<div class:list={['field', 'cell', { wide }]} data-field={name} data-show-when={showWhen}>
  <label class="field-label" for={id}>{label}</label>
  <div class="input-group select">
    <select id={id} name={name}>
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
  </div>
</div>
