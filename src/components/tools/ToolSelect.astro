---
interface Props {
  name: string;
  label: string;
  hint?: string;
  options: { value: string; label: string }[];
  value: string;
  wide?: boolean;
  showWhen?: string;
  /** Server-side initial visibility for showWhen fields (avoids layout shift). */
  initiallyHidden?: boolean;
}
const { name, label, hint, options, value, wide = false, showWhen, initiallyHidden = false } = Astro.props;
const id = `f-${name}`;
---

<div class:list={['field', 'cell', { wide }]} data-field={name} data-show-when={showWhen} hidden={initiallyHidden}>
  <label class="field-label" for={id}>{label}{hint && <span class="hint"> · {hint}</span>}</label>
  <div class="input-group select">
    <select id={id} name={name}>
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
  </div>
</div>
