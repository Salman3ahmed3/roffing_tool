---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/seo';
interface Props {
  title: string;
  lede: string;
  breadcrumbs: Crumb[];
}
const { title, lede, breadcrumbs } = Astro.props;
---

<div class="container intro">
  <Breadcrumbs items={breadcrumbs} />
  <div class="row">
    <div class="text">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </div>
  </div>
</div>

<style>
  .intro {
    padding-top: 14px;
    padding-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .lede {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-neutral-800);
    max-width: 720px;
  }
  @media (min-width: 768px) {
    .intro {
      padding-top: 28px;
      padding-bottom: 28px;
      gap: var(--space-3);
    }
    .lede {
      font-size: 18px;
    }
  }
</style>
