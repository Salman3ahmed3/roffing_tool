# AdSense. Leave PUBLIC_ADSENSE_CLIENT empty and no ad code or ad space is rendered anywhere.
PUBLIC_ADSENSE_CLIENT=
# One ad-unit ID per placement. A slot without an ID is not rendered.
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
PUBLIC_ADSENSE_SLOT_IN_CONTENT=

# Dev/review only: show dashed placeholder boxes where ads will go (ignored when a client ID is set).
PUBLIC_AD_PLACEHOLDERS=false
